# Copy to .env.local for local development. For the live site (GitHub Pages),
# set these as GitHub repository *variables* instead (see README → Deployment).

# ---- Enquiry form (delivered to info@gtechlights.com by Web3Forms) ----
# Get a free access key at https://web3forms.com using info@gtechlights.com.
# The key is public by design (it only allows sending to that inbox).
# Without it, the form shows an email / WhatsApp / call fallback.
NEXT_PUBLIC_WEB3FORMS_KEY=

# ---- WhatsApp ----
# International format, digits only (no + or spaces). Defaults to 918197831032.
NEXT_PUBLIC_WHATSAPP_NUMBER=918197831032
