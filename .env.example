# ---- Contact form (enquiries are emailed to info@gtechlights.com) ----
# SMTP account used to send enquiry emails, e.g. the info@gtechlights.com mailbox
# (Google Workspace: smtp.gmail.com / 465 with an App Password; Zoho: smtp.zoho.in / 465).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional overrides
ENQUIRY_TO=info@gtechlights.com
ENQUIRY_FROM=

# ---- WhatsApp ----
# International format, digits only (no + or spaces). Defaults to 918197831032.
NEXT_PUBLIC_WHATSAPP_NUMBER=918197831032
